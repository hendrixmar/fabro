digraph ManagedDebuggerSmoke {
graph [goal="Verify native and OMP agents receive centrally managed debugger MCP without container configuration", model_stylesheet=".native { model: minimax-m3; } .omp { backend: acp; harness: omp; model: minimax-m3; }"];
start [shape=Mdiamond];
exit [shape=Msquare];
setup [shape=parallelogram, script="python3 -c 'from pathlib import Path; Path(\"/workspace/debugger-proof.py\").write_text('\"'\"'def subtotal(unit, count):\\n    total = unit * count\\n    return total\\n\\nprint(subtotal(6, 7))\\n'\"'\"'); Path(\"/workspace/debugger-proof.cjs\").write_text('\"'\"'function subtotal(unit, count) {\\n  const total = unit * count;\\n  return total;\\n}\\nconsole.log(subtotal(6, 7));\\n'\"'\"')'"];
native_python [class="native", label="Native Python debugger", prompt="Verify Fabro-managed MCP debugger access. Use the injected mcp-debugger MCP tools; do not run shell/Python commands to debug, calculate results, or write proof files. Create a python debug session. Set a breakpoint at line 3 of /workspace/debugger-proof.py. Start debugging that script. Get the stack trace, then local variables for the subtotal frame; observe total. In THAT paused subtotal frame call evaluate_expression with this exact expression: __import__('pathlib').Path('/workspace/proof-python.json').write_text(__import__('json').dumps({'total': total})). This records the real paused variable for the following independent command gate. Close the debug session even if inspection fails. Do not edit source or git, do not print credentials. Reply with a short factual summary only after the tools return. If tools fail, explain the failure; never fabricate proof."];
check_native [shape=parallelogram, goal_gate=true, script="python3 -c 'import json; d=json.load(open('\"'\"'/workspace/proof-python.json'\"'\"')); assert d['\"'\"'total'\"'\"']==42; print('\"'\"'MCP paused-state proof: python, total=42'\"'\"')'"];
omp_javascript [class="omp", label="OMP JavaScript debugger", prompt="Verify Fabro-managed MCP debugger access. Use the injected mcp-debugger MCP tools; do not run shell/Python commands to debug, calculate results, or write proof files. Create a javascript debug session. Set a breakpoint at line 3 of /workspace/debugger-proof.cjs. Start debugging that script. Get the stack trace, then local variables for the subtotal frame; observe total. In THAT paused subtotal frame call evaluate_expression with this exact expression: require('fs').writeFileSync('/workspace/proof-javascript.json', JSON.stringify({total})). This records the real paused variable for the following independent command gate. Close the debug session even if inspection fails. Do not edit source or git, do not print credentials. Reply with a short factual summary only after the tools return. If tools fail, explain the failure; never fabricate proof."];
check_omp [shape=parallelogram, goal_gate=true, script="python3 -c 'import json; d=json.load(open('\"'\"'/workspace/proof-javascript.json'\"'\"')); assert d['\"'\"'total'\"'\"']==42; print('\"'\"'MCP paused-state proof: javascript, total=42'\"'\"')'"];
start -> setup -> native_python -> check_native -> omp_javascript -> check_omp -> exit;
}